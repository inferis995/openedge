# Industrial Edge Middleware - Environment Configuration
# Copy this file to .env and update values for your deployment

# ===========================================
# DATA STORAGE PATHS
# ===========================================
# Where PostgreSQL stores its data on your local machine.
# Use an absolute path to store data on a specific drive.
# Default (if not set): ./data/postgres (relative to the repo folder)
#
# Examples:
#   Linux/Mac:  POSTGRES_DATA_PATH=/opt/openedge/data/postgres
#   Windows:    POSTGRES_DATA_PATH=D:/openedge-data/postgres
POSTGRES_DATA_PATH=./data/postgres

# Where Redis stores its data on your local machine.
# Default (if not set): ./data/redis
REDIS_DATA_PATH=./data/redis

# ===========================================
# DATABASE CONFIGURATION
# ===========================================
POSTGRES_DB=industrial_edge
POSTGRES_USER=industrial_user
POSTGRES_PASSWORD=CHANGE_ME_IN_PRODUCTION
DB_HOST=postgres
DB_PORT=5432

# ===========================================
# REDIS CONFIGURATION
# ===========================================
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=

# ===========================================
# MQTT CONFIGURATION
# ===========================================
MQTT_HOST=mosquitto
MQTT_PORT=1883
MQTT_CLIENT_ID=core-api

# ===========================================
# API SERVER CONFIGURATION
# ===========================================
PORT=8081
BACKUP_PATH=/backups

# ===========================================
# SECURITY WARNING
# ===========================================
# For production deployments:
# 1. Generate strong passwords for all services
# 2. Enable SSL/TLS for database connections
# 3. Disable MQTT anonymous access
# 4. Use Docker secrets instead of environment variables
# 5. Enable authentication for Redis if exposed
