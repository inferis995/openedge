# Industrial Edge Middleware - Environment Configuration
# Copy this file to .env and update values for your deployment

# ===========================================
# DATA STORAGE PATHS
# ===========================================
# By default, data is stored in Docker named volumes (postgres_data, redis_data).
# Named volumes persist across restarts and work on ALL platforms (Windows, Mac, Linux).
# They are deleted only with 'make clean' (docker-compose down -v).
#
# OPTIONAL — Linux/Mac only: override with an absolute path on your disk.
# WARNING: bind mounts do NOT work on Windows (Docker Desktop permission limitation).
#
# To store on a specific path (Linux/Mac):
#   POSTGRES_DATA_PATH=/opt/openedge/data/postgres
#   REDIS_DATA_PATH=/opt/openedge/data/redis
#
# Leave commented out to use the default Docker named volumes (recommended).
# POSTGRES_DATA_PATH=
# REDIS_DATA_PATH=

# ===========================================
# DATABASE CONFIGURATION
# ===========================================
POSTGRES_DB=industrial_edge
POSTGRES_USER=industrial_user
POSTGRES_PASSWORD=CHANGE_ME_IN_PRODUCTION
DB_HOST=postgres
DB_PORT=5432

# ===========================================
# REDIS CONFIGURATION
# ===========================================
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=

# ===========================================
# MQTT CONFIGURATION
# ===========================================
MQTT_HOST=mosquitto
MQTT_PORT=1883
MQTT_CLIENT_ID=core-api

# ===========================================
# API SERVER CONFIGURATION
# ===========================================
PORT=8081
BACKUP_PATH=/backups

# ===========================================
# SECURITY WARNING
# ===========================================
# For production deployments:
# 1. Generate strong passwords for all services
# 2. Enable SSL/TLS for database connections
# 3. Disable MQTT anonymous access
# 4. Use Docker secrets instead of environment variables
# 5. Enable authentication for Redis if exposed
