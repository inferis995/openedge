# Industrial Edge Middleware - Environment Configuration
# Copy this file to .env and update values for your deployment

# ===========================================
# DATABASE CONFIGURATION
# ===========================================
POSTGRES_DB=industrial_edge
POSTGRES_USER=industrial_user
POSTGRES_PASSWORD=CHANGE_ME_IN_PRODUCTION
DB_HOST=postgres
DB_PORT=5432

# ===========================================
# REDIS CONFIGURATION
# ===========================================
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=

# ===========================================
# MQTT CONFIGURATION
# ===========================================
MQTT_HOST=mosquitto
MQTT_PORT=1883
MQTT_CLIENT_ID=core-api

# ===========================================
# API SERVER CONFIGURATION
# ===========================================
PORT=8081
BACKUP_PATH=/backups

# ===========================================
# SECURITY WARNING
# ===========================================
# For production deployments:
# 1. Generate strong passwords for all services
# 2. Enable SSL/TLS for database connections
# 3. Disable MQTT anonymous access
# 4. Use Docker secrets instead of environment variables
# 5. Enable authentication for Redis if exposed
