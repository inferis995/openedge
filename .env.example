# Industrial Edge Middleware - Environment Configuration
# Copy this file to .env and update values for your deployment

# ===========================================
# DATA STORAGE PATHS
# ===========================================
# Default: data stored in ./data/ inside the repo folder.
# Works on Windows, Linux and Mac (timescaledb:latest-pg16 image).
#
# To store on a specific absolute path (Linux/Mac):
#   POSTGRES_DATA_PATH=/opt/openedge/data/postgres
#   REDIS_DATA_PATH=/opt/openedge/data/redis
#
# To store on another Windows drive:
#   POSTGRES_DATA_PATH=D:/openedge-data/postgres
#   REDIS_DATA_PATH=D:/openedge-data/redis
#
# Leave commented out to use the default (./data/postgres and ./data/redis).
# POSTGRES_DATA_PATH=
# REDIS_DATA_PATH=

# ===========================================
# DATABASE CONFIGURATION
# ===========================================
POSTGRES_DB=industrial_edge
POSTGRES_USER=industrial_user
POSTGRES_PASSWORD=CHANGE_ME_IN_PRODUCTION
DB_HOST=postgres
DB_PORT=5432

# ===========================================
# REDIS CONFIGURATION
# ===========================================
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=

# ===========================================
# MQTT CONFIGURATION
# ===========================================
MQTT_HOST=mosquitto
MQTT_PORT=1883
MQTT_CLIENT_ID=core-api

# ===========================================
# API SERVER CONFIGURATION
# ===========================================
PORT=8081
BACKUP_PATH=/backups

# ===========================================
# WEB UI PORT
# ===========================================
# Change if port 3000 is already in use (e.g. WEB_UI_PORT=3001)
# WEB_UI_PORT=3000

# ===========================================
# SECURITY - JWT
# ===========================================
# REQUIRED: Generate with: openssl rand -hex 32
# The application will refuse to start if this is not set.
JWT_SECRET=CHANGE_ME_GENERATE_WITH_openssl_rand_hex_32

# ===========================================
# SECURITY WARNING
# ===========================================
# For production deployments:
# 1. Generate strong passwords for all services
# 2. Enable SSL/TLS for database connections
# 3. Disable MQTT anonymous access
# 4. Use Docker secrets instead of environment variables
# 5. Enable authentication for Redis if exposed
