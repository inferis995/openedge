# Industrial Edge Middleware - Environment Configuration
# Copy this file to .env and update values for your deployment

# ===========================================
# DATA STORAGE PATHS
# ===========================================
# Default: data stored in ./data/ inside the repo folder.
# Works on Windows, Linux and Mac (timescaledb:latest-pg16 image).
#
# To store on a specific absolute path (Linux/Mac):
#   POSTGRES_DATA_PATH=/opt/openedge/data/postgres
#   REDIS_DATA_PATH=/opt/openedge/data/redis
#
# To store on another Windows drive:
#   POSTGRES_DATA_PATH=D:/openedge-data/postgres
#   REDIS_DATA_PATH=D:/openedge-data/redis
#
# Leave commented out to use the default (./data/postgres and ./data/redis).
# POSTGRES_DATA_PATH=
# REDIS_DATA_PATH=

# ===========================================
# DATABASE CONFIGURATION
# ===========================================
POSTGRES_DB=industrial_edge
POSTGRES_USER=industrial_user
POSTGRES_PASSWORD=CHANGE_ME_IN_PRODUCTION
DB_HOST=postgres
DB_PORT=5432

# ===========================================
# REDIS CONFIGURATION
# ===========================================
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=

# ===========================================
# MQTT CONFIGURATION
# ===========================================
MQTT_HOST=mosquitto
MQTT_PORT=1883
MQTT_CLIENT_ID=core-api

# MQTT broker admin credentials — used by core-api and engine-historian.
# On first start Mosquitto bootstraps a Dynamic Security admin with these values.
# REQUIRED for multi-tenant auth. Generate with: openssl rand -hex 16
MQTT_ADMIN_USER=core-api
MQTT_ADMIN_PASSWORD=CHANGE_ME_GENERATE_WITH_openssl_rand_hex_16

# Public MQTT host/port exposed to edge devices (may differ from internal Docker hostname).
# Used when returning MQTT credentials to the edge config API.
# Example: MQTT_PUBLIC_HOST=openedge.mycompany.com
# Example: MQTT_PUBLIC_PORT=18830
MQTT_PUBLIC_HOST=localhost
MQTT_PUBLIC_PORT=18830

# ===========================================
# API SERVER CONFIGURATION
# ===========================================
PORT=8081
BACKUP_PATH=/backups

# Allowed origins for CORS and WebSocket (comma-separated).
# Default (dev): localhost:3000 only.
# Production: set to your actual domain.
# Example: ALLOWED_ORIGINS=https://scada.mycompany.com
ALLOWED_ORIGINS=http://localhost:3000

# ===========================================
# WEB UI PORT
# ===========================================
# Change if port 3000 is already in use (e.g. WEB_UI_PORT=3001)
# WEB_UI_PORT=3000

# ===========================================
# SECURITY - JWT
# ===========================================
# REQUIRED: Generate with: openssl rand -hex 32
# The application will refuse to start if this is not set.
JWT_SECRET=CHANGE_ME_GENERATE_WITH_openssl_rand_hex_32

# Swagger UI — set to true only for development/debugging.
# Never enable in production (exposes full API schema).
SWAGGER_ENABLED=false

# Log format: "json" for production (machine-parseable, works with Loki/Datadog/CloudWatch)
# Leave empty or "text" for local development (human-readable)
LOG_FORMAT=json

# ===========================================
# ON-PREM TLS (optional, internal Caddy)
# ===========================================
# Hostname Caddy will serve over HTTPS with its own internal CA when you
# use `make onprem-tls`. Set this to whatever the factory PCs will dial:
# - an internal DNS name like "openedge.local"
# - or the server's LAN IP
PUBLIC_HOST=openedge.local

# One-shot bootstrap: if set on first start, the migration's default
# "admin / admin123" password is rotated to this value. Subsequent restarts
# with the same env are a no-op (the password is no longer the default).
# Pick a strong one — minimum 12 chars enforced.
OPENEDGE_INITIAL_ADMIN_PASSWORD=

# ===========================================
# BACKUP (on-prem)
# ===========================================
# Nightly pg_dump cadence (cron expression, UTC). Default: 03:00 every day.
BACKUP_SCHEDULE=0 3 * * *

# How many days of dumps to keep. Older files are pruned automatically.
BACKUP_RETENTION_DAYS=30

# Optional: age public key. Set this to encrypt every backup so it is safe
# to copy off-host (USB key, NAS, off-site). Generate the keypair with:
#     age-keygen -o age-key.txt   # then store age-key.txt safely OFF the host
#     grep '^# public key:' age-key.txt
# Leave empty for plaintext backups (acceptable when /backups is on an
# encrypted disk and never leaves it).
BACKUP_AGE_RECIPIENT=

# ===========================================
# EDGE AGENT CONFIGURATION
# ===========================================
# Used by driver-manager for heartbeat and OTA update polling.
# ORG_ID: the numeric org ID this edge belongs to (set when deploying edge agent)
ORG_ID=
# AGENT_VERSION: current version tag of this edge deployment (e.g. v1.0.0)
AGENT_VERSION=v1.0.0
# CORE_API_URL: full URL of the core API (for edge→cloud communication in SaaS mode)
# For on-prem leave as internal docker URL
CORE_API_URL=http://core-api:8081
# CORE_API_TOKEN: JWT token for edge agent to authenticate to core API
# Generate after first login: POST /api/auth/login → use the token here
CORE_API_TOKEN=
# HEALTH_PORT: port for driver-manager internal health server (default 8081)
HEALTH_PORT=8081

# ===========================================
# SECURITY WARNING
# ===========================================
# For production deployments:
# 1. Generate strong passwords for all services
# 2. Enable SSL/TLS for database connections
# 3. Disable MQTT anonymous access
# 4. Use Docker secrets instead of environment variables
# 5. Enable authentication for Redis if exposed
