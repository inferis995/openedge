# Binaries for programs and plugins
*.exe
*.exe~
*.dll
*.so
*.dylib

# Test binary, built with `go test -c`
*.test

# Output of the go coverage tool
*.out

# Go workspace file
go.work

# Dependency directories
vendor/

# Build output — Go binaries
bin/
dist/
/cli
# `go build ./services/<name>/` drops the binary in the CURRENT directory, so
# running it from the repo root leaves these here (the per-service paths below
# only cover builds run inside the service directory).
/core-api
/engine-historian
/driver-manager
/driver-modbus
/driver-mqtt
/driver-opcua
/driver-redis
/driver-s7
/driver-lorawan

# Node.js
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Build outputs
services/web-ui/dist/
services/web-ui/build/

# Environment files
.env
.env.local
.env.*.local

# IDE
.idea/
.vscode/
*.swp
*.swo
*~

# OS files
.DS_Store
Thumbs.db

# Docker volumes (local data)
postgres_data/
redis_data/
data/
mosquitto/data/*
!mosquitto/data/.gitignore
mosquitto/log/*
!mosquitto/log/.gitignore

# Mosquitto Dynamic Security state — generated on first start by
# mosquitto/docker-entrypoint.sh INTO mosquitto/config, which is bind-mounted
# straight from this git tree. The file holds the broker admin credential and one
# password hash per organization, so it must never be committed.
# (mosquitto/config/mosquitto.conf is tracked on purpose and is not matched here.)
mosquitto/config/dynamic-security.json
mosquitto/config/dynamic-security.json.*
mosquitto/config/*.db
# Password files / TLS material if an operator adds any alongside the conf.
mosquitto/config/passwd*
mosquitto/config/pwfile*
mosquitto/config/*.pw
mosquitto/config/acl_file*
mosquitto/config/*.key
mosquitto/config/*.pem
mosquitto/config/*.crt

# Temporary files
nul
*.tmp
*.temp
*.log

# Release builds (use tags instead)
Releases/

# Task outputs
tasks/

# Claude local files
.claude/*.local.md
.claude/settings.local.json
.claude/worktrees/

# Compiled services
services/core-api/core-api
services/engine-historian/engine-historian
services/driver-manager/driver-manager

# Backup files (keep directory, exclude content)
backups/*.zip
backups/*.sql
backups/*.sql.gz

# Release archives (keep folder, exclude content)
release-*/openedge-*.tar.gz
release-*/openedge-*.zip

# TypeScript incremental build state. Machine-specific, changes on every build,
# and was tracked — so every `tsc` run showed up as a dirty working tree and got
# swept into unrelated commits.
*.tsbuildinfo
