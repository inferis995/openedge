# ============================================================
# OpenEdge — Cloud / SaaS deployment configuration
# cp .env.cloud.example .env   then fill in every CHANGE_ME
# ============================================================

# ── Domain & TLS ─────────────────────────────────────────────
# The public hostname that customers will use.
# DNS A record must point to this server's IP BEFORE starting.
PUBLIC_HOST=app.yourcompany.com

# Email for Let's Encrypt expiry notifications (required by ACME).
ACME_EMAIL=ops@yourcompany.com

# ── Database ─────────────────────────────────────────────────
POSTGRES_DB=industrial_edge
POSTGRES_USER=industrial_user
# Generate: openssl rand -hex 24
POSTGRES_PASSWORD=CHANGE_ME_STRONG_DB_PASSWORD
DB_HOST=postgres
DB_PORT=5432

# ── Redis ────────────────────────────────────────────────────
REDIS_HOST=redis
REDIS_PORT=6379
# Optional but recommended: when set, redis-server starts with --requirepass and
# core-api / engine-historian / redis-exporter authenticate with it.
# Leave empty to keep the previous password-less behaviour.
# Generate: openssl rand -hex 24
REDIS_PASSWORD=

# ── MQTT broker ──────────────────────────────────────────────
MQTT_HOST=mosquitto
MQTT_PORT=1883
MQTT_CLIENT_ID=core-api
# Generate: openssl rand -hex 16
MQTT_ADMIN_USER=core-api
MQTT_ADMIN_PASSWORD=CHANGE_ME_STRONG_MQTT_PASSWORD

# Public endpoint published to edge devices via /api/edge/config
# Edge connects via mqtts://${PUBLIC_HOST}:8883  (TLS terminated by Traefik)
MQTT_PUBLIC_HOST=${PUBLIC_HOST}
MQTT_PUBLIC_PORT=8883

# ── API server ───────────────────────────────────────────────
PORT=8081
BACKUP_PATH=/backups
LOG_FORMAT=json

# CORS: must match your domain (HTTPS)
ALLOWED_ORIGINS=https://${PUBLIC_HOST}

# ── Security ─────────────────────────────────────────────────
# Generate: openssl rand -hex 32
JWT_SECRET=CHANGE_ME_GENERATE_WITH_openssl_rand_hex_32

# Encrypts the MQTT broker and cloud-connector passwords kept in
# global_settings. Must be EXACTLY 32 bytes (AES-256).
#
# Without it core-api starts anyway and stores those credentials in cleartext,
# saying so once in a log line nobody reads. On a multi-tenant deployment that
# is every customer's broker password, in the clear, in the database.
# Generate: openssl rand -hex 16
ENCRYPTION_KEY=CHANGE_ME_openssl_rand_hex_16

# Disable Swagger in production
SWAGGER_ENABLED=false

# ── Initial admin password ────────────────────────────────────
# Set once; after first start this is a no-op.
OPENEDGE_INITIAL_ADMIN_PASSWORD=CHANGE_ME_STRONG_ADMIN_PASSWORD

# ── Monitoring ───────────────────────────────────────────────
# Only used with the monitoring profile (make vps-up-monitoring), which is NOT
# on by default. When you do turn it on, Grafana is published through Traefik at
# grafana.${PUBLIC_HOST} — so it needs its own DNS A record, and it must not
# keep the placeholder below: that password is written in a public repository.
# The compose file only refuses an EMPTY value, so the placeholder would satisfy
# it; preflight.sh --with-monitoring is what actually refuses it.
# Generate: openssl rand -base64 24
GRAFANA_ADMIN_PASSWORD=CHANGE_ME_STRONG_GRAFANA_PASSWORD

# AlertManager email routing (configure in monitoring/alertmanager.yml)
ALERTMANAGER_EMAIL_FROM=alerts@yourcompany.com
ALERTMANAGER_EMAIL_TO=ops@yourcompany.com
ALERTMANAGER_SMTP_HOST=localhost:587
ALERTMANAGER_SMTP_USER=
ALERTMANAGER_SMTP_PASS=

# ── Backup (optional) ────────────────────────────────────────
BACKUP_SCHEDULE="0 3 * * *"
BACKUP_RETENTION_DAYS=30
BACKUP_AGE_RECIPIENT=
