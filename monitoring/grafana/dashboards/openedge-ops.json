{
  "title": "OpenEdge Operations",
  "uid": "openedge-ops",
  "tags": ["openedge"],
  "timezone": "browser",
  "refresh": "30s",
  "schemaVersion": 38,
  "panels": [
    {
      "id": 1, "type": "stat", "title": "API Status",
      "gridPos": {"x":0,"y":0,"w":4,"h":4},
      "targets": [{"expr":"up{job=\"openedge-api\"}","legendFormat":"API"}],
      "options": {"reduceOptions":{"calcs":["lastNotNull"]},"colorMode":"background"},
      "fieldConfig": {"defaults":{"mappings":[{"type":"value","options":{"0":{"text":"DOWN","color":"red"},"1":{"text":"UP","color":"green"}}}]}}
    },
    {
      "id": 2, "type": "stat", "title": "API Request Rate",
      "gridPos": {"x":4,"y":0,"w":4,"h":4},
      "targets": [{"expr":"sum(rate(http_requests_total{job=\"openedge-api\"}[5m]))","legendFormat":"req/s"}],
      "fieldConfig": {"defaults":{"unit":"reqps","color":{"mode":"thresholds"},"thresholds":{"steps":[{"value":0,"color":"green"},{"value":50,"color":"yellow"},{"value":100,"color":"red"}]}}}
    },
    {
      "id": 3, "type": "stat", "title": "API p99 Latency",
      "gridPos": {"x":8,"y":0,"w":4,"h":4},
      "targets": [{"expr":"histogram_quantile(0.99, sum(rate(http_request_duration_seconds_bucket{job=\"openedge-api\"}[5m])) by (le))","legendFormat":"p99"}],
      "fieldConfig": {"defaults":{"unit":"s","color":{"mode":"thresholds"},"thresholds":{"steps":[{"value":0,"color":"green"},{"value":0.5,"color":"yellow"},{"value":2,"color":"red"}]}}}
    },
    {
      "id": 4, "type": "stat", "title": "DB Connections",
      "gridPos": {"x":12,"y":0,"w":4,"h":4},
      "targets": [{"expr":"pg_stat_activity_count{datname=\"industrial_edge\"}","legendFormat":"connections"}],
      "fieldConfig": {"defaults":{"unit":"short","color":{"mode":"thresholds"},"thresholds":{"steps":[{"value":0,"color":"green"},{"value":15,"color":"yellow"},{"value":20,"color":"red"}]}}}
    },
    {
      "id": 5, "type": "stat", "title": "Redis Memory",
      "gridPos": {"x":16,"y":0,"w":4,"h":4},
      "targets": [{"expr":"redis_memory_used_bytes / redis_memory_max_bytes","legendFormat":"used"}],
      "fieldConfig": {"defaults":{"unit":"percentunit","color":{"mode":"thresholds"},"thresholds":{"steps":[{"value":0,"color":"green"},{"value":0.7,"color":"yellow"},{"value":0.9,"color":"red"}]}}}
    },
    {
      "id": 6, "type": "stat", "title": "MQTT Clients",
      "gridPos": {"x":20,"y":0,"w":4,"h":4},
      "targets": [{"expr":"mosquitto_clients_connected","legendFormat":"connected"}],
      "fieldConfig": {"defaults":{"unit":"short","color":{"mode":"fixed","fixedColor":"blue"}}}
    },
    {
      "id": 7, "type": "timeseries", "title": "API Request Rate & Errors",
      "gridPos": {"x":0,"y":4,"w":12,"h":8},
      "targets": [
        {"expr":"sum(rate(http_requests_total{job=\"openedge-api\",code=~\"2..\"}[5m]))","legendFormat":"2xx (success)"},
        {"expr":"sum(rate(http_requests_total{job=\"openedge-api\",code=~\"5..\"}[5m]))","legendFormat":"5xx (errors)"},
        {"expr":"sum(rate(http_requests_total{job=\"openedge-api\",code=~\"4..\"}[5m]))","legendFormat":"4xx (client errors)"}
      ],
      "fieldConfig": {"defaults":{"unit":"reqps"},"overrides":[{"matcher":{"id":"byName","options":"5xx (errors)"},"properties":[{"id":"color","value":{"mode":"fixed","fixedColor":"red"}}]}]}
    },
    {
      "id": 8, "type": "timeseries", "title": "API Latency Percentiles",
      "gridPos": {"x":12,"y":4,"w":12,"h":8},
      "targets": [
        {"expr":"histogram_quantile(0.50, sum(rate(http_request_duration_seconds_bucket{job=\"openedge-api\"}[5m])) by (le))","legendFormat":"p50"},
        {"expr":"histogram_quantile(0.95, sum(rate(http_request_duration_seconds_bucket{job=\"openedge-api\"}[5m])) by (le))","legendFormat":"p95"},
        {"expr":"histogram_quantile(0.99, sum(rate(http_request_duration_seconds_bucket{job=\"openedge-api\"}[5m])) by (le))","legendFormat":"p99"}
      ],
      "fieldConfig": {"defaults":{"unit":"s"},"overrides":[{"matcher":{"id":"byName","options":"p99"},"properties":[{"id":"color","value":{"mode":"fixed","fixedColor":"red"}}]}]}
    },
    {
      "id": 9, "type": "timeseries", "title": "PostgreSQL Connections & Queries",
      "gridPos": {"x":0,"y":12,"w":12,"h":8},
      "targets": [
        {"expr":"pg_stat_activity_count{datname=\"industrial_edge\"}","legendFormat":"Active connections"},
        {"expr":"rate(pg_stat_database_xact_commit{datname=\"industrial_edge\"}[5m])","legendFormat":"Commits/s"},
        {"expr":"rate(pg_stat_database_xact_rollback{datname=\"industrial_edge\"}[5m])","legendFormat":"Rollbacks/s"}
      ],
      "fieldConfig": {"defaults":{"unit":"short"}}
    },
    {
      "id": 10, "type": "timeseries", "title": "Redis Operations & Memory",
      "gridPos": {"x":12,"y":12,"w":12,"h":8},
      "targets": [
        {"expr":"rate(redis_commands_processed_total[5m])","legendFormat":"Commands/s"},
        {"expr":"redis_memory_used_bytes","legendFormat":"Memory used"},
        {"expr":"rate(redis_keyspace_hits_total[5m]) / (rate(redis_keyspace_hits_total[5m]) + rate(redis_keyspace_misses_total[5m]))","legendFormat":"Hit rate"}
      ],
      "fieldConfig": {"defaults":{"unit":"short"},"overrides":[{"matcher":{"id":"byName","options":"Memory used"},"properties":[{"id":"unit","value":"bytes"}]},{"matcher":{"id":"byName","options":"Hit rate"},"properties":[{"id":"unit","value":"percentunit"}]}]}
    },
    {
      "id": 11, "type": "timeseries", "title": "MQTT Messages/s",
      "gridPos": {"x":0,"y":20,"w":12,"h":8},
      "targets": [
        {"expr":"rate(mosquitto_messages_received_total[5m])","legendFormat":"Received/s"},
        {"expr":"rate(mosquitto_messages_sent_total[5m])","legendFormat":"Sent/s"}
      ],
      "fieldConfig": {"defaults":{"unit":"short"}}
    },
    {
      "id": 12, "type": "logs", "title": "Container Logs (core-api)",
      "gridPos": {"x":12,"y":20,"w":12,"h":8},
      "targets": [{"expr":"{container_name=\"openedge-core-api\"}","legendFormat":""}],
      "options": {"dedupStrategy":"none","enableLogDetails":true,"showTime":true}
    }
  ],
  "time": {"from": "now-1h", "to": "now"}
}
